{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"extends": ["@hello10/config-biome/base"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["**/*.test.*"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	]
}
