{
	"name": "@hello10/diagrams",
	"version": "0.1.0",
	"description": "Plaintext diagram grammar, parser, and SVG renderer — sequence, state, flowchart, class, ui",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Stephen Handley",
		"email": "stephen@hello10.com",
		"url": "https://hello10.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Hello10/diagrams.git"
	},
	"keywords": [
		"diagram",
		"diagrams",
		"svg",
		"sequence-diagram",
		"state-diagram",
		"flowchart",
		"class-diagram",
		"ui",
		"storyboard",
		"plaintext",
		"parser"
	],
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"test": "vp test",
		"check": "vp check",
		"fix": "vp check --fix",
		"verify": "vp pack && vp check && vp test",
		"examples": "vp dev examples",
		"prepublishOnly": "vp run build",
		"prepare": "vp config",
		"clean": "rm -rf dist node_modules"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@hello10/config-typescript": "^1.0.0",
		"@hello10/config-vite-plus": "^1.0.0",
		"@types/node": "^26.2.0",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.22.2",
			"onFail": "download"
		}
	}
}
